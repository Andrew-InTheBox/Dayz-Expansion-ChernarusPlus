# Keep Workshop metadata stubs so a fresh checkout can discover and sync mods.
# Ignore all other downloaded payload beneath client and server-side mod folders.
/@*/*
!/@*/meta.cpp
/_@*/*
!/_@*/meta.cpp
.env
config/DataCache/cache.ch
dayz.gproj
# Heatmap session output - runtime data written every 2 min by the _@Heatmap server mod
config/Heatmap/
*.exe
*.RPT
*.ADM
*.log
*.dll
*.bisign
*.pbo
*.bin
*.vdf
*.mdmp
*.ebo
/battlefield
/bliss
/dta
/keys
/addons
/mpmissions/Expansion.chernarusplus/storage_1/
/appcache
/logs
sakhal/addons/
/battleye
.continueignore
.vscode/
__pycache__/
.mypy_cache/
custom_scripts/*/output/*
!custom_scripts/*/output/.gitkeep
/tmp
config/ExpansionMod/Settings/SocialMediaSettings.json

# Exception: the custom Heatmap server mod is NOT on the workshop, so it can never
# be re-downloaded or re-synced from Steam - git is the only backup. Track everything
# in it (must come after the /_@*/*, *.pbo and *.bisign ignores above to override them).
!/_@Heatmap/**
